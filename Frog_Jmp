import math

def solution(x,y,d):
    distance_to_cover = y - x
    # If distance_to_cover/d is an integer
    if distance_to_cover % d == 0:
        return distance_to_cover//d
    else:
        return distance_to_cover//d + 1 # This rounds the division upwards to nearest int

result = solution(10, 85, 30)
print(result)
